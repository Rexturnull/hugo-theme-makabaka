.nav-pill{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border-radius:.4rem;padding:.5rem .75rem;text-decoration:none;transition:background-color .15s ease,color .15s ease}*{box-sizing:border-box}html{font-family:-apple-system,BlinkMacSystemFont,segoe ui,Helvetica,Arial,sans-serif;font-size:16px}@media(min-width:64em){html{font-size:18px}}body{margin:0;color:#4a4a4a;background-color:#fff}a{color:#2b2b2b}a:hover,a:focus{color:#000}h1,h2,h3,h4,h5,h6{color:#2b2b2b;font-weight:600;line-height:1.3}@media(min-width:48em){.layout{margin-left:20rem}}.layout--article{margin-left:0}.content{max-width:42rem;margin:0 auto;padding:2rem 1.25rem 4rem}.content--wide{max-width:48rem}.content--home{max-width:60rem;margin:0 auto}.site-footer{color:#8a8a8a;font-size:.8rem;text-align:center;padding:2rem 0}.home-grid{display:flex;flex-direction:column;gap:2rem}@media(min-width:48em){.home-grid{flex-direction:row;align-items:flex-start;gap:3rem}}.home-main{flex:1;min-width:0}.home-aside{flex:0 0 16rem}@media(min-width:48em){.home-aside{position:sticky;top:2rem}}.sidebar-profile{padding:2.5rem 1.5rem;background-color:#202020;color:rgba(255,255,255,.6);text-align:center}@media(min-width:48em){.sidebar-profile{position:fixed;top:0;left:0;bottom:0;width:20rem;overflow-y:auto}}.sidebar-profile__avatar{display:block;width:7rem;height:7rem;border-radius:50%;object-fit:cover;margin:0 auto 1rem}.sidebar-profile__name{color:#fff;font-size:1.75rem;margin:0 0 .25rem}.sidebar-profile__title{font-size:.9rem;text-transform:uppercase;letter-spacing:.05em;margin:0 0 1rem}.sidebar-profile__bio{font-size:.95rem;line-height:1.5;margin-bottom:1.5rem}.sidebar-profile__social{margin-bottom:1.5rem}.sidebar-profile__social-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.25rem}.sidebar-profile__social-list li{width:100%}.sidebar-profile__social-list a{display:flex;width:100%;color:#fff;font-size:.85rem}.sidebar-profile__social-list a:hover{background-color: