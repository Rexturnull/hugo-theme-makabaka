rticle-body tr:nth-child(even) td{background-color:#f5f5f5}.article-toc{display:none}@media(min-width:90em){.article-toc{display:block;position:fixed;top:6rem;left:calc(50% + 48rem/2 + 2rem);width:14rem;max-height:calc(100vh - 8rem);overflow-y:auto;font-size:.85rem}}.article-toc__header{display:flex;align-items:center;justify-content:space-between;gap:.5rem}.article-toc__title{font-weight:600;color:#2b2b2b;font-size:.8rem;text-transform:uppercase;letter-spacing:.03em}.article-toc__toggle{background:0 0;border:none;cursor:pointer;color:#8a8a8a;font-size:.7rem;padding:.2rem;line-height:1}.article-toc__toggle:hover{color:#2b2b2b}.article-toc__body{margin-top:.6rem}.article-toc.is-collapsed .article-toc__body{display:none}.article-toc ul{list-style:none;margin:0;padding-left:0}.article-toc ul ul{padding-left:.9rem}.article-toc li{margin:.3rem 0}.article-toc a{display:block;color:#8a8a8a;text-decoration:none}.article-toc a:hover{color:#2b2b2b}.article-toc__top{margin-top:1.5rem;padding-top:.6rem;border-top:1px solid #eaeaea;font-size:.8rem;text-align:center}.article-footer{margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #eaeaea}.post-pager{display:flex;justify-content:space-between;margin-top:1.5rem;gap:1rem}.post-pager a{color:#2b2b2b;text-decoration:none;font-size:.9rem}.post-pager a:hover{text-decoration:underline}.related-posts{margin-top:1.5rem}.related-posts h2{font-size:1.1rem}.related-posts ul{padding-left:1.1rem}body.lang-zh .lang-en{display:none}body.lang-en .lang-zh{display:none}.lang-toggle{display:inline-flex;border:1px solid #eaeaea;border-radius:.25rem;overflow:hidden;margin-bottom:1.5rem}.lang-toggle button{background:#fff;border:none;padding:.35rem .8rem;font-size:.8rem;cursor:pointer;color:#4a4a4a}.lang-toggle button.is-active{background-color:#2b2b2b;color:#fff}